WORKER_ID=gpu-1
WORKER_TTS_TOKEN=replace-with-a-tts-secret
WORKER_ADMIN_TOKEN=replace-with-a-different-admin-secret
WORKER_HOST=0.0.0.0
WORKER_PORT=8787
MAX_BATCH_SIZE=32
LOG_LEVEL=INFO
WORKER_VERSION=3.0.0

WORKER_INSTALL_ROOT=/opt/higgs-worker
WORKER_ENV_FILE=/opt/higgs-worker/.env
WORKER_LOG_DIR=/var/log/higgs-worker
MODEL_CACHE_DIR=/workspace/model-cache

HIGGS_SGLANG_MAX_RUNNING=4
HIGGS_SGLANG_CUDA_GRAPH_MAX_BS=4
HIGGS_SGLANG_BACKEND_PORT=8096
HIGGS_WORKER_SHUTDOWN_TIMEOUT=120
